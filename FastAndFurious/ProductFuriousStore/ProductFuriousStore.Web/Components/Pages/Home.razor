@page "/"
@using ProductFuriousStore.ApiService.Client
@using ProductFuriousStore.Contracts.Entities
@inject IProductFuriousStoreApiHttpClient _apiclient

<PageTitle>Home</PageTitle>

<h1>Products</h1>

@if (_products.Count == 0)
{
    <p>No products found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Price</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in _products)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.Category</td>
                    <td>@product.Price</td>
                    <td><button class="btn btn-danger btn-sm" @onclick="() => DeleteProduct(product.Id)">Delete</button></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IList<Product> _products = [];

    protected override async Task OnInitializedAsync()
    {
        _products = await _apiclient.GetAllFromController();
    }

    private async Task DeleteProduct(int id)
    {
        await _apiclient.DeleteFromController(id);
        _products = await _apiclient.GetAllFromController();
    }
}
